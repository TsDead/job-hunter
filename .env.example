# Скопируй этот файл в .env и заполни значения.
# Токен бота — получить у @BotFather (команда /newbot).
BOT_TOKEN=123456:ABC-DEF...
# Твой chat_id — узнать у @userinfobot (просто напиши ему /start).
CHAT_ID=123456789
# Бесплатный ключ Groq для AI-фильтра — console.groq.com (без карты).
GROQ_API_KEY=gsk_...
# (опц.) сменить модель: openai/gpt-oss-20b | openai/gpt-oss-120b | qwen/qwen3.8-27b
# LLM_MODEL=openai/gpt-oss-20b
